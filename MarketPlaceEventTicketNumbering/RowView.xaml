<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MarketPlaceEventTicketNumbering.RowView">
    <Grid RowDefinitions="25" ColumnDefinitions="100,100,100,100,100,100">
        <Label x:Name="VersionData" Grid.Row="0" Grid.Column="0" HorizontalOptions="Center"/>
        <Label x:Name="MailingData" Grid.Row="0" Grid.Column="1" HorizontalOptions="Center"/>
        <Label x:Name="PrefixData" Grid.Row="0" Grid.Column="2" HorizontalOptions="Center"/>
        <Label x:Name="QuantityData" Grid.Row="0" Grid.Column="3" HorizontalOptions="Center"/>
        <Label x:Name="OversData" Grid.Row="0" Grid.Column="4" HorizontalOptions="Center"/>
        <Label x:Name="GroupData" Grid.Row="0" Grid.Column="5"  HorizontalOptions="Center"/>
    </Grid>
</ContentView>
